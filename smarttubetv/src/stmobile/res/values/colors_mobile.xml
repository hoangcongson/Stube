<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- STUBE(theme): app surfaces stay pure white in every system appearance. The matching
         values-night resources prevent Android's night qualifier from restoring tinted surfaces. -->
    <!-- Primary surface stays white; use the separate accent token only for foreground icon/text tint. -->
    <color name="mobile_color_primary">#FFFFFF</color>
    <color name="mobile_color_primary_dark">#FFFFFF</color>
    <color name="mobile_color_icon_accent">#625BEE</color>
    <!-- Cast: the only place the app tints an icon to show a live connection. Was the stock
         Material pink (#FF4081) inherited from the theme's colorAccent, which leaked into
         every checkbox, radio, caret and untinted spinner - see Theme.Stube. -->
    <color name="mobile_color_cast_active">#1684C7</color>
    <color name="mobile_color_background">#FFFFFF</color>
    <color name="mobile_glass_fill">#FFFFFF</color>
    <color name="mobile_glass_tint">#FFFFFF</color>
    <color name="mobile_glass_stroke">#FFD9D9D9</color>
    <color name="mobile_header_glass_button_fill">#FFFFFFFF</color>
    <color name="mobile_header_glass_button_stroke">#FFD9D9D9</color>
    <color name="mobile_nav_active">#514BD6</color>
    <color name="mobile_nav_inactive">#475569</color>
    <color name="mobile_color_primary_container">#FFFFFF</color>
    <color name="mobile_color_primary_container_stroke">#FFE5E5E5</color>
    <color name="mobile_you_row_ripple">#14000000</color>
    <color name="mobile_browse_scrim_top">#FFFFFFFF</color>
    <color name="mobile_browse_scrim_middle">#FFFFFFFF</color>
    <color name="mobile_browse_scrim_bottom">#FFFFFFFF</color>
    <color name="mobile_color_surface">#FFFFFF</color>
    <color name="mobile_color_on_surface">#172033</color>
    <color name="mobile_color_on_surface_secondary">#657189</color>
    <color name="mobile_color_badge_bg">#CC000000</color>
    <color name="mobile_color_badge_live_bg">#CCD32F2F</color>
    <color name="mobile_color_progress_track">#33FFFFFF</color>
    <!-- STUBE(seek bar): YouTube's red since its 2024 refresh, the seek bar's played colour
         (PlayerTimeBar.PLAYED_COLOR), so every progress line - watched bars on thumbnails, the
         mini player's - matches the player's. -->
    <color name="mobile_color_progress">#FF0033</color>
    <color name="mobile_color_placeholder">#FFFFFF</color>
    <!-- STUBE(motion): the light that sweeps over skeleton blocks (ShimmerLinearLayout). -->
    <color name="mobile_color_skeleton_highlight">#FFFFFF</color>
    <color name="mobile_color_link">#4F67D8</color>
    <color name="mobile_color_qr_bg">#FFFFFF</color>
    <color name="mobile_color_divider">#1F000000</color>
    <color name="mobile_color_pill">#FFFFFFFF</color>
    <!-- Opaque button surface: MaterialButton flattens a translucent tint onto its base. -->
    <color name="mobile_color_subscribed_button">#FFFFFF</color>
    <!-- STUBE(comments-panel): the comment a replies page is about, set apart from its replies. -->
    <color name="mobile_color_comment_parent">#FFFFFF</color>
    <!-- The creator's handle on their own comments, and the panel's Top / Newest menu. -->
    <color name="mobile_color_comment_creator_pill">#FFFFFFFF</color>
    <color name="mobile_color_menu_surface">#FFFFFF</color>
    <!-- A commenter's handle: brighter than the time beside it, quieter than the comment. -->
    <color name="mobile_color_comment_handle">#4D5A73</color>

    <!-- Shared surface tokens; values-night mirrors these white surfaces. -->
    <!-- A raised card on the page: the watch page's Comments / Live chat / queue cards. -->
    <color name="mobile_color_card">#FFFFFF</color>
    <!-- Main-action controls use the same white surface as the page. -->
    <color name="mobile_color_inverse_surface">#FFFFFF</color>
    <color name="mobile_color_on_inverse_surface">#172033</color>
    <color name="mobile_color_inverse_ripple">#33FFFFFF</color>
    <!-- The unfilled part of a progress bar on a page or sheet (not over a picture). -->
    <color name="mobile_color_track">#1F000000</color>
    <!-- Search fields use the same white surface as the page. -->
    <color name="mobile_color_field">#FFFFFF</color>
    <!-- Kept as a solid page token for older layouts that still reference the wash. -->
    <color name="mobile_color_background_scrim">#FFFFFFFF</color>
    <!-- Pre-Android 8.1 fallback: the system cannot draw dark navigation buttons on a light bar. -->
    <color name="mobile_color_navigation_bar">#FFFFFF</color>

    <!-- STUBE(theme): the shared edit dialogs (SimpleEditDialog - new/rename playlist, passwords -
         and WebProxyDialog) use the library's fixed dark AppDialog colours; the light side
         overrides them here, values-night keeps the library's values. -->
    <color name="dialog_bg_color">#FFFFFF</color>
    <color name="dialog_text_color">#172033</color>
    <color name="dialog_hint_color">#61657189</color>
    <color name="dialog_proxy_hint_color">#8A657189</color>

    <!-- STUBE(theme): player chrome, the same in BOTH themes - the player stays dark like
         YouTube's: controls and chips over the video, the mini player, the cast overlays. -->
    <color name="mobile_player_on_video">#FFFFFF</color>
    <color name="mobile_player_pill">#26FFFFFF</color>
    <color name="mobile_player_cast_active">#4FC3F7</color>
</resources>
