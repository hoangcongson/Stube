<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen mobile browse shell with the floating transparent header and glass bottom dock. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/mobile_glass_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/mobile_browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"><!-- Browse draws its page backdrop behind the
         transparent system navigation bar; its dock/scroll anchor preserve the safe-area inset. -->

    <ImageView
        android:id="@+id/mobile_browse_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/mobile_browse_backdrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_mobile_browse_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Keep feed thumbnails from showing through the logo/actions area. The content list begins
         at the top edge to support immersive scrolling; this surface gives the header its own
         calm, theme-matched background while leaving the rest of the page unchanged. -->
    <View
        android:id="@+id/mobile_topbar_surface"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header controls float above the theme-matched surface; action buttons keep their circles. -->
    <ImageButton
        android:id="@+id/mobile_title_back"
        android:layout_width="48dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:elevation="8dp"
        android:contentDescription="@string/mobile_dialog_back"
        android:padding="12dp"
        android:src="@drawable/ic_mobile_back_arrow"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/mobile_title_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:text="@string/app_name"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="invisible"
        android:elevation="8dp"
        app:layout_constraintEnd_toStartOf="@id/mobile_cast_button"
        app:layout_constraintStart_toEndOf="@id/mobile_title_back"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/mobile_title_logo"
        android:layout_width="84dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/stube_wordmark"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="@id/mobile_title_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

    <!-- Cast picker entry on the home feed, like the official app's top bar. Tinted with the
         accent while a session is connected (MobileBrowseActivity.updateCastIconTint). -->
    <ImageButton
        android:id="@+id/mobile_cast_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_mobile_header_action"
        android:contentDescription="@string/mobile_cast_button"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_mobile_cast"
        app:layout_constraintEnd_toStartOf="@id/mobile_search_button"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar"
        app:layout_constraintBottom_toBottomOf="@id/mobile_title_bar" />

    <ImageButton
        android:id="@+id/mobile_search_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_mobile_header_action"
        android:contentDescription="@string/mobile_search_button"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_mobile_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar"
        app:layout_constraintBottom_toBottomOf="@id/mobile_title_bar" />

    <!-- Pull-to-refresh drives BrowsePresenter.refresh() - also the natural retry
         gesture when a section shows the error placeholder (the error overlay doesn't
         consume touches, so the pull still reaches this layout). -->
    <com.siro.stube.mobile.ui.common.HapticSwipeRefreshLayout
        android:id="@+id/mobile_content_swipe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_content_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingTop="@dimen/mobile_title_bar_height"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

    </com.siro.stube.mobile.ui.common.HapticSwipeRefreshLayout>

    <include
        layout="@layout/mobile_feed_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
         The empty/error placeholder is anchored to the screen edges
         (NOT to the content grid): when a section is empty or sign-in gated the grid is
         set GONE, and ConstraintLayout collapses any view constrained to a GONE view to
         a zero-size point - which is exactly why the signed-out Subscriptions/Playlists
         sections used to render as a blank black area with no message. Independent
         anchors keep the placeholder centered and visible over the (empty) content area.
         (First-load progress is the card skeleton above, not a spinner.)
    -->
    <LinearLayout
        android:id="@+id/mobile_error_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/mobile_error_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mobile_empty" />

        <TextView
            android:id="@+id/mobile_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_error_action"
            style="@style/Widget.Stube.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- "You" tab (replaces the old navigation drawer + top-bar settings icon): account row,
         every enabled BrowsePresenter section that isn't in the bottom nav, then Settings.
         Rows are inflated from item_mobile_you_row in MobileBrowseActivity.rebuildYouRows(). -->
    <ScrollView
        android:id="@+id/mobile_you_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/mobile_color_background"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_title_bar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Account header: circular avatar, name, email, and a compact account action. -->
            <LinearLayout
                android:id="@+id/mobile_you_account_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:id="@+id/mobile_you_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mobile_account" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mobile_you_account_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dialog_add_account"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mobile_you_account_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/mobile_color_on_surface_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/mobile_you_manage"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_mobile_you_manage"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/mobile_you_manage"
                    android:textColor="@color/mobile_color_icon_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="8dp"
                android:background="@color/mobile_color_divider" />

            <LinearLayout
                android:id="@+id/mobile_you_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- YouTube-style FLOATING mini-player: just the live video (no bar), a rounded card
         hovering over the grid's bottom-right corner above the bottom nav. GONE by default;
         it floats OVER content (like YouTube), so the grid keeps its bottom-nav constraint.
         The video is NOT a PlayerView: the card re-parents the playback activity's
         session-long SurfaceTexture into a code-managed TextureView inside the frame below
         (see MobileBrowseActivity#attachMiniTexture + MiniPlayerBridge.getSessionTexture) -
         the codec's surface never changes, so the hand-off never freezes playback. The
         freeze ImageView shows the last captured frame during attach/detach beats.
         Tap video = expand; overlaid play/pause + X; 2dp progress. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mobile_mini_player"
        android:contentDescription="@string/mobile_mini_expand"
        android:layout_width="180dp"
        android:layout_height="102dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- STUBE(issue #9): an AspectRatioFrameLayout (FIT), given the video's shape by
                 MiniPlayerBridge.fitToVideo: other shapes are letterboxed, not stretched. -->
            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/mobile_mini_player_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/mobile_mini_freeze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <ImageButton
                android:id="@+id/mobile_mini_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mini_scrim_circle"
                android:contentDescription="@string/mobile_mini_play_pause"
                android:padding="9dp"
                android:src="@drawable/ic_player_pause" />

            <!-- 48dp touch target, wholly inside the card (a child outside its parent gets no touches), around the same 40dp circle (was 28dp, then 40dp - STUBE(touch)). -->
            <ImageButton
                android:id="@+id/mobile_mini_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="0dp"
                android:background="@drawable/bg_mini_scrim_circle_touch"
                android:contentDescription="@string/mobile_mini_close"
                android:padding="15dp"
                android:src="@drawable/ic_sheet_close"
                android:tint="@color/mobile_player_on_video" />

            <ProgressBar
                android:id="@+id/mobile_mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                tools:progress="400" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Mirrors the measured, inset-aware dock height so list and mini-player content clear it. -->
    <View
        android:id="@+id/mobile_bottom_nav_anchor"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </eightbitlab.com.blurview.BlurTarget>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/mobile_bottom_glass"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_mobile_glass_nav_outline"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:outlineProvider="background"
        app:blurOverlayColor="@color/mobile_color_background">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/mobile_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="0dp"
            android:background="@android:color/transparent"
            android:alpha="0"
            android:importantForAccessibility="noHideDescendants"
            app:itemIconSize="18dp"
            app:itemIconTint="@color/mobile_bottom_nav_item"
            app:itemTextAppearanceActive="@style/MobileBottomNavText"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:itemTextAppearanceInactive="@style/MobileBottomNavText"
            app:itemPaddingTop="1dp"
            app:itemPaddingBottom="1dp"
            app:paddingBottomSystemWindowInsets="false"
            app:itemTextColor="@color/mobile_bottom_nav_item"
            app:itemHorizontalTranslationEnabled="false"
            app:labelVisibilityMode="labeled" />

        <!-- Fixed-size, equal-width dock items avoid BottomNavigationView label scaling on narrow
             phones. The hidden Material view above remains the source of tab state and callbacks. -->
        <LinearLayout
            android:id="@+id/mobile_bottom_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp" />

    </eightbitlab.com.blurview.BlurView>

</FrameLayout>
